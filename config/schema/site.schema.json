{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://web-harvester.local/schemas/site.schema.json",
  "title": "Web Harvester Site Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site_id": {
      "type": "string",
      "description": "Identifier injected automatically when loading the config."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The display name of the site."
    },
    "base_url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "The base URL of the site, used to resolve relative links."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of items to collect before stopping."
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of list pages to crawl. Takes precedence as a cap over pagination.max_pages."
        },
        "stop_on_duplicate": {
          "type": "boolean",
          "description": "Stop crawling when a duplicate URL is encountered."
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Overall crawl timeout in seconds."
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/classifier_source"
          },
          "description": "Ordered list of classification sources. The first source that yields a non-empty value wins."
        },
        "default": {
          "type": "string",
          "description": "Fallback category used when no source yields a value."
        }
      },
      "required": ["sources"],
      "description": "Optional article classification into a single category."
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/classifier_source"
          },
          "description": "List of classification sources whose values are accumulated into the article tags."
        }
      },
      "required": ["sources"],
      "description": "Optional auto-tagging configuration producing a list of tags."
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cookies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "list_page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "List page URL. May contain a {page} placeholder for pagination."
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST"]
        },
        "type": {
          "type": "string",
          "enum": ["html", "json"]
        },
        "selectors": {
          "$ref": "#/$defs/list_selectors"
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["enabled"]
        }
      },
      "required": ["url", "type"]
    },
    "article_page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["html", "json"]
        },
        "selectors": {
          "type": "object",
          "description": "Map of output field names to a CSS selector / JSON path (string) or a field configuration object.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/field_config"
              }
            ]
          }
        }
      },
      "required": ["type"],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "html"
              }
            }
          },
          "then": {
            "properties": {
              "selectors": {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/html_field_config"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "json"
              }
            }
          },
          "then": {
            "properties": {
              "selectors": {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/json_field_config"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": ["name", "base_url"],
  "$defs": {
    "list_selectors": {
      "description": "List page selectors. Use the HTML form for HTML list pages and the JSON form for JSON list pages.",
      "oneOf": [
        {
          "title": "HTML list selectors",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "string",
              "description": "CSS selector for the container of each list item."
            },
            "link": {
              "type": "string",
              "description": "CSS selector for the link element within an item."
            },
            "link_attr": {
              "type": "string",
              "description": "Attribute to read the link URL from (default: href)."
            }
          },
          "required": ["items"]
        },
        {
          "title": "JSON list selectors",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "string",
              "description": "JSON path to the list of items."
            },
            "url_field": {
              "type": "string",
              "description": "Field name holding the article URL within each item."
            },
            "url_template": {
              "type": "string",
              "description": "URL template with a {url} placeholder used to build the final URL."
            }
          },
          "required": ["items", "url_field"]
        }
      ]
    },
    "classifier_source": {
      "description": "A single classification source. The 'type' field selects the extraction strategy; 'mapping' optionally translates raw values into display names.",
      "oneOf": [
        {
          "title": "URL source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "url"
            },
            "regex": {
              "type": "string",
              "description": "Regular expression matched against the article URL. The first capture group is used as the raw value."
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["type", "regex"]
        },
        {
          "title": "Meta source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "meta"
            },
            "name": {
              "type": "string",
              "description": "Value of the meta name attribute, e.g. 'section'."
            },
            "property": {
              "type": "string",
              "description": "Value of the meta property attribute, e.g. 'article:section'."
            },
            "split": {
              "type": "string",
              "description": "Delimiter used to split the meta content into multiple tags (tags only)."
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["type"],
          "anyOf": [
            {
              "required": ["name"]
            },
            {
              "required": ["property"]
            }
          ]
        },
        {
          "title": "Selector source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "selector"
            },
            "selector": {
              "type": "string",
              "description": "CSS selector targeting an element in the article HTML."
            },
            "attr": {
              "type": "string",
              "description": "Attribute to extract. Defaults to 'text'."
            },
            "join": {
              "type": "string",
              "description": "Delimiter used to join multiple matched values (category only); omitting it takes the first match."
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["type", "selector"]
        },
        {
          "title": "JSON-LD source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "json_ld"
            },
            "path": {
              "type": "string",
              "description": "Dot-separated JSON path into the first JSON-LD block, e.g. 'itemListElement.1.name'."
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["type", "path"]
        },
        {
          "title": "List data source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "list_data"
            },
            "path": {
              "type": "string",
              "description": "Dot-separated JSON path into the list item data carried in request meta."
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["type", "path"]
        },
        {
          "title": "Article JSON source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "article_json"
            },
            "path": {
              "type": "string",
              "description": "Dot-separated JSON path into the article JSON response body."
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["type", "path"]
        },
        {
          "title": "Keyword source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "keyword"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "keywords": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "value": {
                    "type": "string",
                    "description": "Category or tag value assigned when any keyword matches the article title or content."
                  }
                },
                "required": ["keywords", "value"]
              }
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["type", "rules"]
        }
      ]
    },
    "classifier_mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Maps raw extracted values to display names, e.g. {'7251': '股市'}."
    },
    "field_config": {
      "description": "Configuration object for a single extracted field.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "datetime", "attr"]
        },
        "selector": {
          "type": "string",
          "description": "CSS selector (HTML article pages)."
        },
        "path": {
          "type": "string",
          "description": "JSON path (JSON article pages)."
        },
        "attr": {
          "type": "string",
          "description": "Attribute to extract. Defaults to 'text'."
        },
        "datetime_format": {
          "type": "string",
          "description": "strptime format used when type is 'datetime'."
        },
        "regex": {
          "type": "string",
          "description": "Regular expression applied to the extracted value."
        }
      }
    },
    "html_field_config": {
      "description": "Field config for HTML article pages. Requires a CSS selector.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "datetime", "attr"]
        },
        "selector": {
          "type": "string",
          "description": "CSS selector (HTML article pages)."
        },
        "attr": {
          "type": "string",
          "description": "Attribute to extract. Defaults to 'text'."
        },
        "datetime_format": {
          "type": "string",
          "description": "strptime format used when type is 'datetime'."
        },
        "regex": {
          "type": "string",
          "description": "Regular expression applied to the extracted value."
        }
      },
      "required": ["selector"]
    },
    "json_field_config": {
      "description": "Field config for JSON article pages. Requires a JSON path.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "datetime", "attr"]
        },
        "path": {
          "type": "string",
          "description": "JSON path (JSON article pages)."
        },
        "datetime_format": {
          "type": "string",
          "description": "strptime format used when type is 'datetime'."
        },
        "regex": {
          "type": "string",
          "description": "Regular expression applied to the extracted value."
        }
      },
      "required": ["path"]
    }
  }
}