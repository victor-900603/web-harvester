{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://web-harvester.local/schemas/site.schema.json",
  "title": "Web Harvester Site Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The display name of the site."
    },
    "base_url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "The base URL of the site, used to resolve relative links."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of items to collect before stopping."
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of list pages to crawl. Single authoritative value for page count."
        },
        "stop_on_duplicate": {
          "type": "boolean",
          "description": "Stop crawling when a duplicate URL is encountered."
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Overall crawl timeout in seconds."
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/classifier_source"
          },
          "description": "Ordered list of classification sources. The first source that yields a non-empty value wins."
        },
        "default": {
          "type": "string",
          "description": "Fallback category used when no source yields a value."
        }
      },
      "required": ["sources"],
      "description": "Optional article classification into a single category."
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/classifier_source"
          },
          "description": "List of classification sources whose values are accumulated into the article tags."
        }
      },
      "required": ["sources"],
      "description": "Optional auto-tagging configuration producing a list of tags."
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cookies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "list_page": {
      "type": "object",
      "additionalProperties": false,
      "description": "List page configuration. Each source is self-contained: it declares its own method/type/extract (plus optional body/json_body/pagination). A source expresses a filter (keyword/category) when its url/body/json_body contains the matching placeholder.",
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "List URL template. May contain {page}, {keyword} and {category} placeholders; each present placeholder declares the filter the source supports."
              },
              "method": {
                "type": "string",
                "enum": ["GET", "POST"],
                "description": "Request method (default: GET)."
              },
              "type": {
                "type": "string",
                "enum": ["html", "json"],
                "description": "Response type; determines the extract form and parser."
              },
              "body": {
                "type": "string",
                "description": "Raw request body. May contain {page}, {keyword} and {category} placeholders."
              },
              "json_body": {
                "type": "object",
                "description": "JSON request body. String values may contain {page}, {keyword} and {category} placeholders; a value that is exactly a placeholder is substituted with its native type (e.g. {page} becomes an integer)."
              },
              "extract": {
                "$ref": "#/$defs/list_extract"
              },
              "pagination": {
                "$ref": "#/$defs/pagination"
              }
            },
            "required": ["url", "type", "extract"],
            "allOf": [
              {
                "if": {
                  "properties": { "type": { "const": "html" } }
                },
                "then": {
                  "properties": { "extract": { "$ref": "#/$defs/list_extract_html" } }
                }
              },
              {
                "if": {
                  "properties": { "type": { "const": "json" } }
                },
                "then": {
                  "properties": { "extract": { "$ref": "#/$defs/list_extract_json" } }
                }
              }
            ]
          },
          "description": "Ordered list of self-contained list sources. The first source without a {keyword} placeholder is the default list; keyword/category requests pick the best matching source (exact match first, then superset, then graceful degradation)."
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Optional mapping of category name to its in-site URL value, used by --category."
        },
        "category_default": {
          "type": "string",
          "description": "Optional default value for the {category} placeholder when --category is not given."
        }
      },
      "required": ["sources"]
    },
    "article_page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["html", "json"]
        },
        "fields": {
          "type": "object",
          "description": "Map of output field names to a CSS selector / JSON path (string) or a field configuration object. The valid field configuration form depends on article_page.type (see the conditional schemas below)."
        }
      },
      "required": ["type"],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "html"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/html_field_config"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "json"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/json_field_config"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": ["name", "base_url"],
  "$defs": {
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["enabled"]
    },
    "list_extract": {
      "description": "List extract config. Use the HTML form for HTML list sources and the JSON form for JSON list sources.",
      "oneOf": [
        { "$ref": "#/$defs/list_extract_html" },
        { "$ref": "#/$defs/list_extract_json" }
      ]
    },
    "list_extract_html": {
      "title": "HTML list extract",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_selector": {
          "type": "string",
          "description": "CSS selector for the container of each list item."
        },
        "link_selector": {
          "type": "string",
          "description": "CSS selector for the link element within an item."
        },
        "link_attr": {
          "type": "string",
          "description": "Attribute to read the link URL from (default: href)."
        }
      },
      "required": ["item_selector"]
    },
    "list_extract_json": {
      "title": "JSON list extract",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items_path": {
          "type": "string",
          "description": "JSON path to the list of items."
        },
        "url_field": {
          "type": "string",
          "description": "Field name holding the article URL within each item."
        },
        "url_template": {
          "type": "string",
          "description": "URL template with a {url} placeholder used to build the final URL."
        }
      },
      "required": ["items_path", "url_field"]
    },
    "classifier_source": {
      "description": "A single classification source. The 'source' field selects the extraction strategy; 'mapping' optionally translates raw values into display names.",
      "oneOf": [
        {
          "title": "URL source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "url"
            },
            "regex": {
              "type": "string",
              "description": "Regular expression matched against the article URL. The first capture group is used as the raw value."
            },
            "split": {
              "type": "string",
              "description": "Delimiter used to split the raw value into multiple tags/categories."
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["source", "regex"]
        },
        {
          "title": "HTML source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "html"
            },
            "selector": {
              "type": "string",
              "description": "CSS selector targeting element(s) in the article HTML."
            },
            "attr": {
              "type": "string",
              "description": "Attribute to extract. Defaults to 'text'."
            },
            "multiple": {
              "type": "boolean",
              "description": "When true, collect all matching elements; otherwise take the first. Mutually exclusive with 'join'."
            },
            "join": {
              "type": "string",
              "description": "Delimiter used to join multiple matched values (category only); omitting it takes the first match. Mutually exclusive with 'multiple'."
            },
            "split": {
              "type": "string",
              "description": "Delimiter used to split the extracted value into multiple tags/categories."
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["source", "selector"]
        },
        {
          "title": "JSON source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "json"
            },
            "from": {
              "type": "string",
              "enum": ["json_ld", "list_data", "article_json"],
              "description": "JSON data source: json_ld (first JSON-LD block), list_data (list item meta), or article_json (article response body)."
            },
            "path": {
              "type": "string",
              "description": "Dot-separated JSON path into the selected JSON data."
            },
            "split": {
              "type": "string",
              "description": "Delimiter used to split the extracted string value into multiple tags/categories."
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["source", "from", "path"]
        },
        {
          "title": "Keyword source",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "keyword"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "keywords": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "value": {
                    "type": "string",
                    "description": "Category or tag value assigned when any keyword matches the article title or content."
                  }
                },
                "required": ["keywords", "value"]
              }
            },
            "mapping": {
              "$ref": "#/$defs/classifier_mapping"
            }
          },
          "required": ["source", "rules"]
        }
      ]
    },
    "classifier_mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Maps raw extracted values to display names, e.g. {'7251': '股市'}."
    },
    "html_field_config": {
      "description": "Field config for HTML article pages. Requires a CSS selector.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as": {
          "type": "string",
          "enum": ["text", "datetime"],
          "description": "Extraction strategy: text (default) or datetime."
        },
        "selector": {
          "type": "string",
          "description": "CSS selector (HTML article pages)."
        },
        "attr": {
          "type": "string",
          "description": "Attribute to extract. Defaults to 'text'."
        },
        "datetime_format": {
          "type": "string",
          "description": "strptime format used when as is 'datetime'."
        },
        "regex": {
          "type": "string",
          "description": "Regular expression applied to the extracted value."
        }
      },
      "required": ["selector"]
    },
    "json_field_config": {
      "description": "Field config for JSON article pages. Requires a JSON path.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as": {
          "type": "string",
          "enum": ["text", "datetime"],
          "description": "Extraction strategy: text (default) or datetime."
        },
        "path": {
          "type": "string",
          "description": "JSON path (JSON article pages)."
        },
        "datetime_format": {
          "type": "string",
          "description": "strptime format used when as is 'datetime'."
        },
        "regex": {
          "type": "string",
          "description": "Regular expression applied to the extracted value."
        }
      },
      "required": ["path"]
    }
  }
}
