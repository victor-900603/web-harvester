{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://web-harvester.local/schemas/settings.schema.json",
  "title": "Web Harvester General Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["name", "version"]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["sync", "async"]
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "request_timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "download_delay": {
          "type": "number",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["mode"]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_agent": {
          "type": "string",
          "minLength": 1
        },
        "verify_ssl": {
          "type": "boolean"
        },
        "http_client": {
          "type": "string",
          "enum": ["curl_cffi", "httpx"],
          "description": "HTTP client implementation. curl_cffi provides TLS fingerprint impersonation; httpx is the fallback without fingerprinting."
        },
        "impersonate": {
          "type": "string",
          "enum": ["chrome99", "chrome100", "chrome101", "chrome104", "chrome107", "chrome110", "chrome116", "chrome119", "chrome120", "chrome122", "chrome124", "chrome131", "chrome131_android", "safari15_3", "safari15_5", "safari17_0", "safari17_2_ios", "safari18_0", "safari18_0_ios", "firefox133", "edge101", "edge122", ""],
          "description": "Browser to impersonate for TLS fingerprint (JA3/Akamai). Empty string disables impersonation; when set, ja3/akamai are ignored."
        },
        "ja3": {
          "type": "string",
          "description": "Custom JA3 string. Only effective when http_client is curl_cffi and impersonate is empty."
        },
        "akamai": {
          "type": "string",
          "description": "Custom Akamai HTTP/2 fingerprint string. Only effective when http_client is curl_cffi and impersonate is empty."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of items to collect before stopping."
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of list pages to crawl. Single authoritative value for page count."
        },
        "stop_on_duplicate": {
          "type": "boolean",
          "description": "Stop crawling when a duplicate URL is encountered."
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Overall crawl timeout in seconds."
        }
      }
    },
    "category_normalization": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        },
        "format": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "backup_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["level"]
    },
    "json_storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "output_dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["enabled"]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "echo": {
          "type": "boolean"
        },
        "pool_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_overflow": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["enabled"]
    }
  },
  "required": ["app", "engine"]
}